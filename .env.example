# Salin menjadi .env.local lalu sesuaikan.

# Kosongkan untuk memakai PGlite (PostgreSQL dalam WebAssembly) di folder .data/.
# Isi untuk memakai PostgreSQL sungguhan, mis. dari docker-compose.yml:
# DATABASE_URL=postgres://tirai:tirai@localhost:5432/tirai

# Lokasi data PGlite (opsional).
# PGLITE_DIR=.data/pglite

# Rahasia server untuk HMAC. WAJIB diisi di produksi; buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Password akun demo yang dibuat oleh `npm run db:seed` (opsional).
# DEMO_PASSWORD=tirai-demo-2026
